Host *
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519_sk_rk_diptanw

Host dyptanm.local
    User goga
    PreferredAuthentications password

Host rpi5.dyptan.dev
    User pi
    ForwardAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host win.dyptan.dev
    User dyptan.io
    IdentityFile ~/.ssh/id_ed25519

Host github.com
    ForwardAgent yes
    IdentityFile ~/.ssh/id_ed25519

Host *
    LogLevel ERROR

